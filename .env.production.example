# ============================================================================
# .env.production.example — C-Call IVR SaaS
#
# PLACEHOLDER FILE ONLY. Never commit real secrets.
# Copy to .env.production on the production server.
# Set permissions immediately: chmod 600 .env.production
# Owner: the non-root service user running Docker (e.g. ccall).
#
# Generate SECRET_KEY:
#   python3 -c "import secrets; print(secrets.token_hex(64))"
# Generate API_KEY_PEPPER:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Generate Fernet key (SIP_PASSWORD_ENCRYPTION_KEY):
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Generate METRICS_AUTH_TOKEN:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Generate BACKUP_ENCRYPTION_PASSPHRASE:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# ============================================================================

# ── Application ──────────────────────────────────────────────────────────────
FLASK_ENV=production
APP_ENV=production
DEBUG=false
TESTING=false

FLASK_SECRET_KEY=REPLACE_WITH_128_CHAR_HEX_STRING
API_KEY_PEPPER=REPLACE_WITH_64_CHAR_HEX_STRING

APP_BASE_URL=https://app.ccall.com.bd
API_BASE_URL=https://app.ccall.com.bd/api/v1
WEBHOOK_BASE_URL=https://app.ccall.com.bd
APP_URL=https://app.ccall.com.bd
ADMIN_EMAIL=admin@ccall.com.bd

HOST=127.0.0.1
PORT=5000
TRUSTED_PROXIES=127.0.0.1
ALLOW_PRIVATE_WEBHOOKS_FOR_DEV=false
SERVER_NAME=app.ccall.com.bd

# ── Service role guards ───────────────────────────────────────────────────────
# Each service overrides exactly the role it owns.
# Web container: all false.
# Scheduler container: ENABLE_SCHEDULER=true only.
# Call worker container: ENABLE_CALL_WORKER=true only.
ENABLE_SCHEDULER=false
ENABLE_CALL_WORKER=false
ENABLE_CALL_MONITOR=false

# ── Database ──────────────────────────────────────────────────────────────────
# App user — SELECT/INSERT/UPDATE/DELETE only.
DATABASE_URL=postgresql://ccall_app:REPLACE_DB_APP_PASSWORD@postgres:5432/ccall_production
# Migration user — CREATE TABLE, ALTER, DROP, GRANT. Used only at deploy time.
MIGRATION_DATABASE_URL=postgresql://ccall_migrate:REPLACE_DB_MIGRATE_PASSWORD@postgres:5432/ccall_production
# Production DB name must not contain 'staging', 'test', 'dev'.
DB_NAME=ccall_production

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@redis:6379/0
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD
# Session DB = 0, rate limiter = 1, monitor lock = 2, call queue coordination = 3
SESSION_REDIS_DB=0
RATELIMIT_REDIS_DB=1

# ── Gunicorn ──────────────────────────────────────────────────────────────────
GUNICORN_BIND=0.0.0.0:5000
WEB_WORKERS=4
WEB_THREADS=2
LOG_LEVEL=info

# ── Metrics / monitoring ──────────────────────────────────────────────────────
# Bearer token required on every /metrics scrape.
METRICS_AUTH_TOKEN=REPLACE_METRICS_TOKEN_URLSAFE_48
SENTRY_DSN=REPLACE_SENTRY_DSN

# ── SIP ───────────────────────────────────────────────────────────────────────
SIP_DOMAIN=sip.amarip.com
SIP_PORT=5060
SIP_USER=REPLACE_SIP_USER
SIP_PASSWORD=REPLACE_SIP_PASSWORD
SIP_TRANSPORT=udp
# Local bind vs advertised public IPs (for NAT / AWS EC2 / Coolify staging)
SIP_BIND_IP=0.0.0.0
RTP_BIND_IP=0.0.0.0
SIP_ADVERTISED_IP=
RTP_ADVERTISED_IP=
RTP_PORT_MIN=10000
RTP_PORT_MAX=20000
# Fernet key — encrypt SIP credentials at rest in DB
SIP_PASSWORD_ENCRYPTION_KEY=REPLACE_FERNET_KEY
ASTERISK_DIAL_FORMAT=local_bd
# Mock flag — must be false in production
MOCK_SIP_PROVIDER=false
MOCK_TTS_PROVIDER=false
MOCK_PAYMENT_PROVIDER=false

# ── Call behaviour ────────────────────────────────────────────────────────────
CALL_WORKERS=4
CALL_MAX_DURATION_SECONDS=120
SIP_PROCESS_TIMEOUT_SECONDS=90
GATHER_TIMEOUT_SECONDS=8
RECORD_CALLS=1
FFMPEG_PATH=/usr/bin/ffmpeg
CALL_WORKER_POLL_SECONDS=2
LIVE_CALLS_KEEP_COMPLETED_SECONDS=0

# ── TTS ───────────────────────────────────────────────────────────────────────
TTS_MAX_CONCURRENT=2
GEMINI_API_KEY=REPLACE_GEMINI_KEY
ELEVENLABS_API_KEY=REPLACE_ELEVENLABS_KEY
FFMPEG_TIMEOUT_SECONDS=30
EDGE_TTS_TIMEOUT_SECONDS=45
EDGE_TTS_RETRY_DELAY_SECONDS=2
OPENVOICE_TIMEOUT_SECONDS=60
OPENVOICE_FALLBACK_TO_EDGE=true

# ── Payments ──────────────────────────────────────────────────────────────────
SSLCOMMERZ_STORE_ID=REPLACE_STORE_ID
SSLCOMMERZ_STORE_PASSWORD=REPLACE_STORE_PASSWORD
SSLCOMMERZ_SANDBOX=false
PAYMENT_CALLBACK_URL=https://app.ccall.com.bd/payment/callback
BKASH_APP_KEY=REPLACE_BKASH_APP_KEY
BKASH_APP_SECRET=REPLACE_BKASH_APP_SECRET
BKASH_USERNAME=REPLACE_BKASH_USERNAME
BKASH_PASSWORD=REPLACE_BKASH_PASSWORD
BKASH_SANDBOX=false

# Payment webhook signing secret (used to verify SSLCommerz callbacks)
PAYMENT_WEBHOOK_SECRET=REPLACE_PAYMENT_WEBHOOK_SECRET

# ── Email / SMTP ──────────────────────────────────────────────────────────────
SENDGRID_API_KEY=REPLACE_SENDGRID_KEY
MAIL_FROM=noreply@ccall.com.bd
MAIL_FROM_NAME=C-Call IVR
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USE_TLS=true

# ── Storage ───────────────────────────────────────────────────────────────────
# Object storage for TTS cache, recordings, exports.
STORAGE_BACKEND=s3
AWS_ACCESS_KEY_ID=REPLACE_AWS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_AWS_SECRET
AWS_DEFAULT_REGION=ap-south-1
AUDIO_S3_BUCKET=REPLACE_AUDIO_BUCKET
RECORDINGS_S3_BUCKET=REPLACE_RECORDINGS_BUCKET

# ── Backup ────────────────────────────────────────────────────────────────────
BACKUP_ENCRYPTION_PASSPHRASE=REPLACE_BACKUP_PASSPHRASE_URLSAFE_48
BACKUP_S3_BUCKET=REPLACE_BACKUP_BUCKET
BACKUP_S3_PREFIX=ccall-prod
BACKUP_METRICS_DIR=/app/instance/metrics

# ── WooCommerce ───────────────────────────────────────────────────────────────
WOOCOMMERCE_WEBHOOK_SECRET=REPLACE_WC_WEBHOOK_SECRET

# ── Subscription defaults ─────────────────────────────────────────────────────
TRIAL_DAYS=14
GRACE_PERIOD_DAYS=7

# ── Production acceptance test controls ───────────────────────────────────────
# These must be empty in real production deployments.
# Populated only during controlled acceptance testing.
ACCEPTANCE_TEST_PHONE=
ACCEPTANCE_TEST_CALLER_ID=
