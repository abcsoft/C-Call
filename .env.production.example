# ============================================================================
# .env.production.example — C-Call IVR SaaS
# ALL values here are PLACEHOLDERS. Never commit real secrets.
# Copy to .env on the production server (chmod 600, owned by service user).
# Generate SECRET KEY: python -c "import secrets; print(secrets.token_hex(32))"
# Generate FERNET KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ============================================================================

# --- Application ---
FLASK_ENV=production
FLASK_SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_STRING
APP_URL=https://app.ccall.com.bd
ADMIN_EMAIL=admin@ccall.com.bd
HOST=127.0.0.1
PORT=5000
ALLOW_PRIVATE_WEBHOOKS_FOR_DEV=false

# --- Database ---
DATABASE_URL=postgresql://ccall_app:REPLACE_DB_PASSWORD@127.0.0.1:5432/ccall_prod
# Separate migration role (higher privilege, used only at deploy time)
MIGRATION_DATABASE_URL=postgresql://ccall_migrate:REPLACE_MIGRATE_PASSWORD@127.0.0.1:5432/ccall_prod

# --- Redis ---
REDIS_URL=redis://:REPLACE_REDIS_PASSWORD@127.0.0.1:6379/0
REDIS_PASSWORD=REPLACE_REDIS_PASSWORD

# --- Gunicorn ---
GUNICORN_BIND=127.0.0.1:5000
WEB_WORKERS=4
WEB_THREADS=2
LOG_LEVEL=info
TRUSTED_PROXIES=127.0.0.1

# --- Service role guards (must be 'true' only in the service that owns the role) ---
ENABLE_SCHEDULER=false
ENABLE_CALL_WORKER=false
ENABLE_CALL_MONITOR=false

# --- SIP ---
SIP_DOMAIN=sip.amarip.com
SIP_PORT=5060
SIP_USER=REPLACE_SIP_USER
SIP_PASSWORD=REPLACE_SIP_PASSWORD
SIP_PASSWORD_ENCRYPTION_KEY=REPLACE_FERNET_KEY
ASTERISK_DIAL_FORMAT=local_bd

# --- Call behaviour ---
CALL_WORKERS=4
CALL_MAX_DURATION_SECONDS=120
SIP_PROCESS_TIMEOUT_SECONDS=90
GATHER_TIMEOUT_SECONDS=8
RECORD_CALLS=1
FFMPEG_PATH=ffmpeg
CALL_WORKER_POLL_SECONDS=2
LIVE_CALLS_KEEP_COMPLETED_SECONDS=0

# --- TTS ---
TTS_MAX_CONCURRENT=2
GEMINI_API_KEY=REPLACE_GEMINI_KEY
ELEVENLABS_API_KEY=REPLACE_ELEVENLABS_KEY
FFMPEG_TIMEOUT_SECONDS=30
EDGE_TTS_TIMEOUT_SECONDS=45
EDGE_TTS_RETRY_DELAY_SECONDS=2
OPENVOICE_TIMEOUT_SECONDS=60
OPENVOICE_FALLBACK_TO_EDGE=false

# --- Payments ---
SSLCOMMERZ_STORE_ID=REPLACE_STORE_ID
SSLCOMMERZ_STORE_PASSWORD=REPLACE_STORE_PASSWORD
SSLCOMMERZ_SANDBOX=false
BKASH_APP_KEY=REPLACE_BKASH_APP_KEY
BKASH_APP_SECRET=REPLACE_BKASH_APP_SECRET
BKASH_USERNAME=REPLACE_BKASH_USERNAME
BKASH_PASSWORD=REPLACE_BKASH_PASSWORD
BKASH_SANDBOX=false

# --- Email ---
SENDGRID_API_KEY=REPLACE_SENDGRID_KEY
MAIL_FROM=noreply@ccall.com.bd
MAIL_SERVER=smtp.sendgrid.net
MAIL_PORT=587

# --- Monitoring ---
SENTRY_DSN=REPLACE_SENTRY_DSN

# --- Backup ---
BACKUP_ENCRYPTION_PASSPHRASE=REPLACE_BACKUP_PASSPHRASE
BACKUP_S3_BUCKET=REPLACE_S3_BUCKET
BACKUP_S3_PREFIX=ccall-prod
AWS_ACCESS_KEY_ID=REPLACE_AWS_KEY
AWS_SECRET_ACCESS_KEY=REPLACE_AWS_SECRET
AWS_DEFAULT_REGION=ap-south-1

# --- Subscription defaults ---
TRIAL_DAYS=14
GRACE_PERIOD_DAYS=7
