# ------------------------------------------------------------------------------
# C-Call IVR Platform: Environment Variable Configuration
# ------------------------------------------------------------------------------

# --- Application Context ---
# FLASK_ENV=development allows http:// webhook URLs for local testing
# NEVER set this to development in production
FLASK_ENV=production
# Secret key for Flask session cookie signing (64-char random hex recommended)
FLASK_SECRET_KEY=change-me-to-a-long-random-secret-key
APP_URL=https://app.ccall.com.bd
ADMIN_EMAIL=admin@ccall.com.bd
HOST=0.0.0.0
PORT=5000

# --- Database & Cache ---
# PostgreSQL URL (e.g. postgresql://user:password@host:5432/dbname)
DATABASE_URL=postgresql://ccall:ccall_dev_password@localhost:5432/ccall
# Redis URL — include password when REDIS_PASSWORD is set (required in production)
REDIS_URL=redis://:redis_dev_password@localhost:6379/0
REDIS_PASSWORD=redis_dev_password

# --- SIP Configuration (Global Fallbacks) ---
SIP_DOMAIN=sip.amarip.com
SIP_PORT=5060
SIP_USER=your_sip_username
SIP_PASSWORD=your_sip_password
ASTERISK_DIAL_FORMAT=local_bd

# --- Call Orchestrator Controls ---
# Background workers executing concurrent calls
CALL_WORKERS=4
# Maximum length of calls (seconds)
CALL_MAX_DURATION_SECONDS=120
SIP_PROCESS_TIMEOUT_SECONDS=90
GATHER_TIMEOUT_SECONDS=8
RECORD_CALLS=1
FFMPEG_PATH=ffmpeg

# --- Text-to-Speech Settings ---
# Concurrent TTS generation slots
TTS_MAX_CONCURRENT=2
# Provider API keys (optional, fallback to edge-tts if empty)
GEMINI_API_KEY=your_gemini_api_key_here
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# TTS provider timeouts (seconds)
FFMPEG_TIMEOUT_SECONDS=30
EDGE_TTS_TIMEOUT_SECONDS=45
EDGE_TTS_RETRY_DELAY_SECONDS=2
OPENVOICE_TIMEOUT_SECONDS=60
OPENVOICE_FALLBACK_TO_EDGE=false

# --- Payment Gateways ---
# SSLCommerz Integration
SSLCOMMERZ_STORE_ID=your_sslcommerz_store_id
SSLCOMMERZ_STORE_PASSWORD=your_sslcommerz_store_password
SSLCOMMERZ_SANDBOX=true

# bKash Integration
BKASH_APP_KEY=your_bkash_app_key
BKASH_APP_SECRET=your_bkash_app_secret
BKASH_USERNAME=your_bkash_username
BKASH_PASSWORD=your_bkash_password
BKASH_SANDBOX=true

# --- Email Notifications ---
SENDGRID_API_KEY=your_sendgrid_api_key_here
MAIL_FROM=noreply@ccall.com.bd

# --- Monitoring & Error Tracking ---
SENTRY_DSN=https://your_sentry_dsn_here@o0.ingest.sentry.io/0

# --- Cryptography & Security ---
# Fernet key for encrypting SIP passwords in the database
SIP_PASSWORD_ENCRYPTION_KEY=your_fernet_encryption_key_here
